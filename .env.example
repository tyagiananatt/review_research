# ReviewForge Environment Configuration
# 3 Gemini API keys (comma-separated):
GEMINI_KEYS=your_gemini_api_key_1,your_gemini_api_key_2,your_gemini_api_key_3

# 2 Groq API keys (comma-separated for ultra-fast, high-quota fallback):
GROQ_KEYS=your_groq_api_key_1,your_groq_api_key_2

# Active AI Provider: 'auto' (Gemini with Groq fallback), 'gemini', or 'groq'
AI_PROVIDER=auto

# Models
GEMINI_PRIMARY_MODEL=gemini-2.0-flash
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Rate Limiter & Resilience
GEMINI_RPM=15
GROQ_RPM=30
KEY_COOLDOWN_SECONDS=60
SIMILARITY_THRESHOLD=0.75
